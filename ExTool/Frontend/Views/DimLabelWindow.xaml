<Window x:Class="ExTool.Frontend.Views.DimLabelWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Dim ống nhựa" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
		WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
	<Grid Margin="12">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="220" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock Text="Dim style:" VerticalAlignment="Center" Margin="0,4,10,4" />
		<ComboBox x:Name="cbDimStyle" Grid.Column="1" Height="24" Margin="0,4" />

		<TextBlock Grid.Row="1" Text="Layer:" VerticalAlignment="Center" Margin="0,4,10,4" />
		<ComboBox x:Name="cbLayer" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,4" />

		<TextBlock Grid.Row="2" Text="Tỉ lệ:" VerticalAlignment="Center" Margin="0,4,10,4" />
		<Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBox x:Name="tbScale" Height="24" VerticalContentAlignment="Center" PreviewKeyDown="Scale_PreviewKeyDown" />
			<StackPanel Grid.Column="1" Margin="2,0,0,0">
				<RepeatButton Width="22" Height="12" Padding="0" FontSize="7" Content="▲" Click="ScaleUp_Click" />
				<RepeatButton Width="22" Height="12" Padding="0" FontSize="7" Content="▼" Click="ScaleDown_Click" />
			</StackPanel>
		</Grid>

		<TextBlock Grid.Row="3" Text="Khoảng cách text tới ống:" VerticalAlignment="Center" Margin="0,4,10,4" />
		<TextBox x:Name="tbOffset" Grid.Row="3" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,4" />

		<StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
			<Button Width="80" Height="26" Content="OK" IsDefault="True" Click="Ok_Click" />
			<Button Width="80" Height="26" Content="Hủy" IsCancel="True" Margin="8,0,0,0" />
		</StackPanel>
	</Grid>
</Window>
